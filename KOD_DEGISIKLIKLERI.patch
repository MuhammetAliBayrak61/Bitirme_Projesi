+    token=json.loads(read(PC+'/sas/v1/token/modiseuwest/modis-061-cogs'))['token']
+    return blob_inventory(year,token,refresh=True)
+
+def plan(source):
+    validated=report(source)
+    CACHE.mkdir(parents=True,exist_ok=True)
